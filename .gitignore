# The original decompilation is upstream source and is never committed here.
# Clone it with tools/setup.ps1; it is Fast64's import/export target only.
/decomp/

# Staged third-party toolchain: Ship of Harkinian, Fast64, retro.
/.toolchain/

# Never commit a ROM or anything extracted from one.
*.z64
*.n64
*.v64
*.o2r
*.otr
baserom*/

# Build output
/build/
/dist/

# Watchdog run logs
/watchdog/

# Blender
*.blend1
*.blend2

# Python
__pycache__/
*.pyc

# Ripped game assets: source material, never committed.
/.assets/
/.playwright-mcp/

# Ship of Harkinian runtime files, if it is ever launched from here.
/oot.o2r
/shipofharkinian.json
/SoHTimeSplitData.json
/Save/
/logs/
/imgui.ini

# Upstream decompilations of the source games, read for their sound tables only.
# Never committed, same rule as the Ocarina of Time decompilation above.
/decomp-ssb64/
/decomp-k64/

# Capture frames and film from driving the game are never committed: every subfolder of
# docs/preview is ignored except the two small curated sets, and the curated single
# images at the top of docs/preview (final_*.png and the earlier comparisons) are the
# only pictures that go in.
/docs/preview/*/
!/docs/preview/pose/
!/docs/preview/angles/
/docs/preview/v[0-9]*_*.png
/docs/preview/frame*.png
/docs/preview/*.mp4
!/docs/preview/kirby_idle.mp4
/docs/preview/*.png
!/docs/preview/final_*.png

# Audio decoded out of the source ROMs. Same rule as the ripped models: the scripts that
# rebuild it are committed, the publisher's sound is not.
/docs/sounds/
/build/

# Release packages for GameBanana: built from dist/, never committed (they carry the
# model data the ROM rule covers).
/release/
